        <name>Get AIVA Chat</name>
        <operation_script><![CDATA[(function process( /*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    var recordId = request.pathParams.record_id;
    var aiva = new AIVAGenAIAssistant();

    var gr = new GlideRecord('x_168647_aiva_request');
    var preAssessment = '';
    if (gr.get(recordId)) {
        preAssessment = gr.getValue('ai_pre_assessment') || '';
    }

	gs.info('AIVA Chat: ' + recordId);

    response.setStatus(200);
    return {
        recordId: recordId,
		preAssessment: preAssessment,
        history: aiva.getChatHistory(recordId)
    };
	// preAssessment: preAssessment,

})(request, response);]]></operation_script>
